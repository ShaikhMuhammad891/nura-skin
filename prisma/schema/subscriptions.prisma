// Routine Plans (08 §4.8, 11 §7).

model Subscription {
  id                   String               @id @default(cuid(2))
  userId               String               @map("user_id")
  user                 User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  stripeSubscriptionId String               @unique @map("stripe_subscription_id")
  stripeCustomerId     String               @map("stripe_customer_id")
  status               SubscriptionStatus
  intervalWeeks        Int                  @map("interval_weeks")
  currentPeriodStart   DateTime             @map("current_period_start") @db.Timestamptz(3)
  currentPeriodEnd     DateTime             @map("current_period_end") @db.Timestamptz(3)
  nextChargeAt         DateTime?            @map("next_charge_at") @db.Timestamptz(3)
  pausedUntil          DateTime?            @map("paused_until") @db.Timestamptz(3)
  cancelAtPeriodEnd    Boolean              @default(false) @map("cancel_at_period_end")
  canceledAt           DateTime?            @map("canceled_at") @db.Timestamptz(3)
  cancelReason         String?              @map("cancel_reason")
  cancelFeedback       String?              @map("cancel_feedback")
  skipCount            Int                  @default(0) @map("skip_count")
  shippingAddress      Json                 @map("shipping_address")
  originOrderId        String?              @map("origin_order_id")
  originOrder          Order?               @relation("SubscriptionOrigin", fields: [originOrderId], references: [id], onDelete: SetNull)
  consultationId       String?              @map("consultation_id")
  consultation         RoutineConsultation? @relation(fields: [consultationId], references: [id], onDelete: SetNull)
  name                 String
  version              Int                  @default(0)
  createdAt            DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  items        SubscriptionItem[]
  events       SubscriptionEvent[]
  orders       Order[]                @relation("SubscriptionOrders")
  reservations InventoryReservation[]

  @@index([userId, status])
  @@index([status, nextChargeAt])
  @@map("subscriptions")
}

model SubscriptionItem {
  id                       String         @id @default(cuid(2))
  subscriptionId           String         @map("subscription_id")
  subscription             Subscription   @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  variantId                String         @map("variant_id")
  variant                  ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  stripeSubscriptionItemId String         @unique @map("stripe_subscription_item_id")
  stripePriceId            String         @map("stripe_price_id")
  quantity                 Int
  unitAmountCents          Int            @map("unit_amount_cents")
  createdAt                DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([subscriptionId, variantId])
  @@map("subscription_items")
}

model SubscriptionEvent {
  id             String       @id @default(cuid(2))
  subscriptionId String       @map("subscription_id")
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  type           String
  data           Json?
  actorId        String?      @map("actor_id")
  source         String
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([subscriptionId, createdAt])
  @@index([type, createdAt])
  @@map("subscription_events")
}
