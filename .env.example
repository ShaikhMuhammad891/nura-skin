# Nura Skin environment variables (see docs/20-deployment-strategy.md §2).
# Copy to .env.local for local development. Never commit real values.
# Variables are validated at boot by src/lib/env.ts; later milestones add more.

# ── App ────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# local | preview | staging | production
NEXT_PUBLIC_APP_ENV=local
# trace | debug | info | warn | error | fatal
LOG_LEVEL=debug

# Set to 1 only for tooling that builds without secrets (e.g. Docker image layers).
# SKIP_ENV_VALIDATION=

# ── Added in later milestones ──────────────────────────

# M3: NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME, CLOUDINARY_API_KEY, CLOUDINARY_API_SECRET
# M4: UPSTASH_REDIS_REST_URL, UPSTASH_REDIS_REST_TOKEN
# M5: RESEND_API_KEY, EMAIL_FROM, INNGEST_*
# M6: ANTHROPIC_API_KEY, AI_MODEL, AI_CLASSIFIER_MODEL, AI_SELECTION_TIMEOUT_MS, AI_TOTAL_TIMEOUT_MS, AI_MAX_CONCURRENCY, AI_DAILY_CALL_CAP

# ── Clerk (M2) ── Dashboard → Configure → API keys (development instance locally)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Webhook endpoint signing secret (Dashboard → Webhooks); optional until the endpoint exists
CLERK_WEBHOOK_SIGNING_SECRET=
# Portfolio deployment only (ADR-0016)
# DEMO_MODE_ENABLED=false
# Pooled demo staff Clerk ids (comma-separated), printed by `npm run demo:staff`
# DEMO_STAFF_CLERK_USER_IDS=

# ── Stripe (M5) ── TEST MODE keys only (Dashboard → Developers → API keys)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
# Local: printed by `stripe listen --forward-to localhost:3000/api/webhooks/stripe`
STRIPE_WEBHOOK_SECRET=

# ── Database (M1) ──────────────────────────────────────
# Local: `pnpm db:local` starts an embedded Postgres on :5433 (no Docker needed).
# Neon: DATABASE_URL = pooled (-pooler) string, DIRECT_URL = direct string (migrations).
# Use sslmode=verify-full in Neon URLs (Neon often shows sslmode=require, which makes pg print a deprecation warning).
DATABASE_URL=postgresql://nura:nura@localhost:5433/nura_dev
DIRECT_URL=postgresql://nura:nura@localhost:5433/nura_dev
# Scratch DB for `prisma migrate dev` and `pnpm db:drift` (never real data)
SHADOW_DATABASE_URL=postgresql://nura:nura@localhost:5433/nura_shadow

# ── Cookies (M4) ── generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
COOKIE_SECRET=
# COOKIE_SECRET_PREVIOUS=
